@page "/"
@using InvitedClub.DynamicListBox.Client.Components
@using InvitedClub.DynamicListBox.Shared
@inject HttpClient Http

<div @onclick="ClearMarkupSelection">
<p class="dlb-intro">Add or remove activities from the list below.</p>
<DynamicListBox TValue="int"
                @ref="_listBox"
                Items="_dbItems"
                @bind-SelectedValue="_selectedId"
                Width="340px"
                Height="240px" />

 <input @bind="_newText" placeholder="New item text" />
<button @onclick="AddAsync">Add</button>
<button @onclick="RemoveAsync" disabled="@(_selectedId <= 0)">
    Remove Selected
</button>
<hr />

<!-- ChildContent demo -->
    <p class="dlb-intro">Declarative items (ChildContent). Click to select.</p>

<DynamicListBox TValue="int"
                Width="340px"
                Height="120px"
                Items="Array.Empty<ListBoxOption<int>>()"
                @bind-SelectedValue="_selectedMarkupId"
                StopClickPropagation="true">

    <DynamicListBoxItemComponent TValue="int" Value="1" Text="Markup Item A" />
    <DynamicListBoxItemComponent TValue="int" Value="2" Text="Markup Item B" />

</DynamicListBox>

<p class="hint">Selected markup item: @SelectedMarkupLabel</p>
</div>

