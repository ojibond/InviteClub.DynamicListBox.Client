@page "/"
@using InvitedClub.DynamicListBox.Client.Components
@using InvitedClub.DynamicListBox.Shared
@inject HttpClient Http

<DynamicListBoxComponent TValue="int"
                         @ref="_listBox"
                         Items="_dbItems"
                         @bind-SelectedValue="_selectedId"
                         Width="340px"
                         Height="240px">

    <DynamicListBoxItemComponent TValue="int" Value="-1" Text="(Static) Alpha" />
    <DynamicListBoxItemComponent TValue="int" Value="-2" Text="(Static) Beta" />
</DynamicListBoxComponent>

<input @bind="_newText" placeholder="New item text" />
<button @onclick="AddAsync">Add</button>
<button @onclick="RemoveAsync">Remove Selected</button>



