@page "/component-demo"

<h1>DynamicListBox — Component Demo</h1>
<p class="dlb-intro">Declarative items via <code>ChildContent</code>. Click to toggle (multi-select).</p>

<DynamicListBox TValue="int"
                Width="340px"
                Height="160px"
                Items="Array.Empty<ListBoxOption<int>>()"
                AllowMultiple="true"
                @bind-SelectedValues="_selectedMarkupIds">
    <DynamicListBoxItemComponent TValue="int" Value="1" Text="Markup Item A" />
    <DynamicListBoxItemComponent TValue="int" Value="2" Text="Markup Item B" />
    <DynamicListBoxItemComponent TValue="int" Value="3" Text="Markup Item C" />
</DynamicListBox>

<p class="hint">Selected: @SelectedMarkupLabel</p>
