@typeparam TValue

<div class="dlb-container" style="@($"width:{Width};height:{Height};")" @onclick:stopPropagation="StopClickPropagation">
    <div class="dlb-scroll"
         role="listbox"
         tabindex="0"
         aria-multiselectable="@AllowMultiple.ToString().ToLowerInvariant()"
         aria-activedescendant="@ActiveDescendantId"
         @onkeydown="OnKeyDownAsync"
         @onfocus="OnFocus">
        @for (var i = 0; i < _combinedItems.Count; i++)
        {
            var index = i;
            var item = _combinedItems[index];
            <div id="@OptionId(index)"
                 class="@GetItemClass(item, index)"
                 role="option"
                 aria-selected="@IsSelected(item).ToString().ToLowerInvariant()"
                 @onclick="() => OnOptionClickAsync(index)">
                @item.Text
            </div>
        }

        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</div>
